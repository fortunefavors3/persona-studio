{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "persona-studio",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "unsafe": {
    "bindings": [
      {
        "name": "GENERATION_LIMITER",
        "type": "ratelimit",
        "namespace_id": "persona-studio-generation-v1",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "CHARACTER_LIMITER",
        "type": "ratelimit",
        "namespace_id": "persona-studio-character-v1",
        "simple": {
          "limit": 3,
          "period": 60
        }
      },
      {
        "name": "STATUS_LIMITER",
        "type": "ratelimit",
        "namespace_id": "persona-studio-status-v1",
        "simple": {
          "limit": 60,
          "period": 60
        }
      }
    ]
  }
}
