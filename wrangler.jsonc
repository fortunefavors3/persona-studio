{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "persona-studio",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
